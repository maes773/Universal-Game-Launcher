// UGL 0.1 — Foundation. Interfaz funcional y sencilla.
// El diseño esqueumórfico (estanterías, cajas, cartuchos) llega en una etapa posterior.

import { Button, CheckBox, LineEdit, ComboBox, ListView } from "std-widgets.slint";

export struct GameItem {
    id: int,
    title: string,
    source: string,
    ach-total: int,
    ach-unlocked: int,
    icon: image,
    has-icon: bool,
    initial: string,
    owned-only: bool,
}

export struct ExeItem {
    label: string,
    detail: string,
    suggested: bool,
}

export struct GameDetail {
    id: int,
    title: string,
    source: string,
    install-path: string,
    launch-target: string,
    status: string,
    can-change-exe: bool,
    can-change-path: bool,
    ach-total: int,
    ach-unlocked: int,
    can-show-achievements: bool,
    icon: image,
    has-icon: bool,
    initial: string,
    cover: image,
    has-cover: bool,
    info: string,
    description: string,
    store-name: string,
    can-use-store-name: bool,
}

export struct LinkResult {
    name: string,
    app-id: string,
}

export struct PreviewItem {
    include: bool,
    name: string,
    path: string,
    note: string,
    status: string,
    status-kind: int,
    selectable: bool,
}

export struct AchievementItem {
    name: string,
    description: string,
    date-text: string,
    provenance: string,
    icon: image,
    has-icon: bool,
    unlocked: bool,
    hidden: bool,
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 44px;
    border-radius: 6px;
    background: root.selected ? #3b2b1f : transparent;

    TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        x: 14px;
        y: 0px;
        height: parent.height;
        text: root.label;
        color: root.selected ? #f2e6d4 : #b9a58e;
        font-size: 15px;
        vertical-alignment: center;
    }
}

component GameIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> initial;
    in property <length> side: 40px;

    width: root.side;
    height: root.side;
    border-radius: 6px;
    border-width: 1px;
    border-color: #4a3626;
    background: #140e0a;
    clip: true;

    if root.has-icon : Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.icon;
        image-fit: contain;
    }
    if !root.has-icon : Text {
        width: parent.width;
        height: parent.height;
        text: root.initial;
        color: #c98a3b;
        font-size: root.side * 0.5;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component AchievementBadge inherits Rectangle {
    in property <int> unlocked;
    in property <int> total;
    callback clicked();

    width: 104px;
    height: 30px;
    border-radius: 15px;
    border-width: 1px;
    border-color: #c98a3b;
    background: badge-area.has-hover ? #4a3626 : #2a1f18;

    badge-area := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: "Logros " + root.unlocked + "/" + root.total;
        color: #e8b96a;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ImportCard inherits Rectangle {
    in property <string> heading;
    in property <string> description;
    in property <string> button-text;
    in property <bool> button-enabled: true;
    in property <string> button2-text;
    callback activated();
    callback activated2();

    background: #2a1f18;
    border-radius: 10px;
    border-width: 1px;
    border-color: #4a3626;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        Text {
            text: root.heading;
            color: #f2e6d4;
            font-size: 18px;
            font-weight: 700;
        }
        Text {
            text: root.description;
            color: #b9a58e;
            font-size: 13px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: root.button-text;
                enabled: root.button-enabled;
                primary: true;
                clicked => { root.activated(); }
            }
            if root.button2-text != "" : Button {
                text: root.button2-text;
                enabled: root.button-enabled;
                clicked => { root.activated2(); }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "UGL — Universal Game Launcher";
    icon: @image-url("../assets/ugl.png");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 660px;
    background: #1c1511;

    // Estado general
    in property <[GameItem]> games;
    in property <string> status-text;
    in property <bool> busy: false;
    in property <string> version-text;
    in property <string> data-dir;
    in property <string> db-path;
    in property <string> log-path;
    in-out property <int> current-view: 0;
    in-out property <int> sort-index: 0;
    in-out property <bool> auto-update: true;
    in-out property <bool> download-icons: true;

    // Diálogo de importación de un juego individual
    in property <bool> import-dialog-visible: false;
    in property <string> import-folder;
    in-out property <string> import-name;
    in property <[ExeItem]> exe-candidates;
    in-out property <int> selected-exe: -1;
    in property <string> scan-note;

    // Ficha del juego
    // Vista previa de importación de ejecutables
    in property <bool> preview-visible: false;
    in property <[PreviewItem]> preview-items;
    in property <string> preview-summary;
    in property <int> preview-selected: 0;

    // Cuenta de itch.io (opcional)
    in-out property <bool> show-owned: true;
    in property <bool> account-linked: false;
    in property <bool> account-busy: false;
    in property <string> account-status;
    in property <string> account-sync-status;
    in-out property <string> account-key-input;
    // Juego de la cuenta de itch.io que no está instalado
    in property <bool> owned-dialog-visible: false;
    in property <int> owned-app-id: 0;
    in property <string> owned-title;
    in property <string> owned-info;
    in property <string> owned-description;
    in property <image> owned-cover;
    in property <bool> owned-has-cover: false;

    // Segundo plano y ficha de Steam Store
    out property <image> app-icon: @image-url("../assets/ugl.png");
    in-out property <bool> minimize-on-launch: true;
    in-out property <bool> fetch-metadata: true;
    in property <bool> link-dialog-visible: false;
    in property <int> link-game-id: 0;
    in property <string> link-game-title;
    in-out property <string> link-query;
    in property <[LinkResult]> link-results;
    in-out property <int> link-selected: -1;
    in property <string> link-status;
    in property <bool> link-busy: false;

    // Método de inicio de un juego
    in property <bool> launch-dialog-visible: false;
    in property <int> launch-game-id: 0;
    in property <string> launch-game-title;
    in-out property <int> launch-method: 0;
    in-out property <string> launch-exe;
    in-out property <string> launch-args;
    in-out property <string> launch-workdir;
    in-out property <string> launch-steam-id;
    in-out property <string> launch-uri;
    in property <string> launch-error;

    in property <bool> detail-visible: false;
    in property <GameDetail> detail;
    in-out property <bool> confirm-remove: false;

    callback search-changed(string);
    callback sort-changed(int);
    callback game-clicked(int);
    callback play-clicked(int);
    callback import-folder-clicked();
    callback import-steam-clicked();
    callback browse-exe-clicked();
    callback import-confirm(string, int);
    callback import-cancel();
    callback detail-close();
    callback change-exe-clicked(int);
    callback change-path-clicked(int);
    callback remove-clicked(int);
    callback achievements-clicked(int);
    callback import-exes-clicked();
    callback import-shortcuts-clicked();
    callback preview-toggled(int, bool);
    callback preview-name-edited(int, string);
    callback preview-confirm();
    callback preview-cancel();
    callback launch-settings-clicked(int);
    callback launch-browse-exe();
    callback launch-browse-workdir();
    callback launch-save(int);
    callback launch-cancel();
    callback account-unlink-clicked();
    callback account-save-key(string);
    callback account-open-key-page();
    callback account-sync-clicked();
    callback show-owned-toggled(bool);
    callback owned-clicked(int);
    callback owned-store(int);
    callback owned-close();
    callback minimize-to-tray-clicked();
    callback minimize-on-launch-toggled(bool);
    callback fetch-metadata-toggled(bool);
    callback use-store-name-clicked(int);
    callback steam-link-clicked(int);
    callback steam-link-search(string);
    callback steam-link-confirm(int);
    callback steam-link-cancel();
    callback auto-update-toggled(bool);
    callback download-icons-toggled(bool);

    HorizontalLayout {
        // Barra lateral
        Rectangle {
            width: 210px;
            background: #140e0a;

            VerticalLayout {
                padding: 16px;
                spacing: 6px;

                Text {
                    text: "UGL";
                    color: #c98a3b;
                    font-size: 28px;
                    font-weight: 800;
                }
                Text {
                    text: "Universal Game Launcher";
                    color: #8a7662;
                    font-size: 11px;
                }
                Rectangle { height: 18px; }
                NavButton {
                    label: "Biblioteca";
                    selected: root.current-view == 0;
                    clicked => { root.current-view = 0; }
                }
                NavButton {
                    label: "Importar";
                    selected: root.current-view == 1;
                    clicked => { root.current-view = 1; }
                }
                NavButton {
                    label: "Cuenta de itch.io";
                    selected: root.current-view == 3;
                    clicked => { root.current-view = 3; }
                }
                NavButton {
                    label: "Ajustes";
                    selected: root.current-view == 2;
                    clicked => { root.current-view = 2; }
                }
                Rectangle { vertical-stretch: 1; }
                Button {
                    text: "Minimizar a la bandeja";
                    clicked => { root.minimize-to-tray-clicked(); }
                }
            }
        }

        // Contenido
        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            // ---- Biblioteca ----
            if root.current-view == 0 : VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    LineEdit {
                        placeholder-text: "Buscar en la biblioteca…";
                        edited(text) => { root.search-changed(text); }
                    }
                    ComboBox {
                        width: 230px;
                        model: ["Ordenar por título", "Jugados recientemente", "Añadidos recientemente"];
                        current-index: root.sort-index;
                        selected(value) => { root.sort-changed(self.current-index); }
                    }
                    if root.account-linked : CheckBox {
                        text: "Mostrar no instalados";
                        checked <=> root.show-owned;
                        toggled => { root.show-owned-toggled(self.checked); }
                    }
                }

                if root.games.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "Tu biblioteca está vacía.\nVe a «Importar» para añadir un juego o tu carpeta de Steam.";
                        color: #8a7662;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if root.games.length > 0 : ListView {
                    vertical-stretch: 1;
                    for game in root.games : Rectangle {
                        height: 58px;
                        border-radius: 6px;
                        background: row-area.has-hover ? #2f2218 : transparent;

                        row-area := TouchArea {
                            clicked => {
                                if (game.owned-only) {
                                    root.owned-clicked(game.id);
                                } else {
                                    root.game-clicked(game.id);
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 12px;

                            GameIcon {
                                icon: game.icon;
                                has-icon: game.has-icon;
                                initial: game.initial;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: game.title;
                                    color: #f2e6d4;
                                    font-size: 15px;
                                    overflow: elide;
                                }
                                Text {
                                    text: game.source;
                                    color: #8a7662;
                                    font-size: 11px;
                                }
                            }
                            if game.ach-total > 0 : VerticalLayout {
                                alignment: center;
                                AchievementBadge {
                                    unlocked: game.ach-unlocked;
                                    total: game.ach-total;
                                    clicked => { root.achievements-clicked(game.id); }
                                }
                            }
                            if !game.owned-only : Button {
                                text: "Jugar";
                                primary: true;
                                width: 90px;
                                clicked => { root.play-clicked(game.id); }
                            }
                        }
                    }
                }
            }

            // ---- Importar ----
            if root.current-view == 1 : VerticalLayout {
                vertical-stretch: 1;
                spacing: 16px;
                alignment: start;

                Text {
                    text: "Importar";
                    color: #f2e6d4;
                    font-size: 24px;
                    font-weight: 700;
                }
                Text {
                    text: "UGL solo importa cuando tú lo pides. No copia, mueve ni modifica ningún archivo de tus juegos.";
                    color: #b9a58e;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                ImportCard {
                    height: 140px;
                    heading: "Importar juego individual";
                    description: "Elige la carpeta donde está instalado el juego. UGL buscará los ejecutables y te dejará elegir cuál usar para iniciarlo.";
                    button-text: "Elegir carpeta del juego…";
                    button-enabled: !root.busy;
                    activated => { root.import-folder-clicked(); }
                }
                ImportCard {
                    height: 140px;
                    heading: "Importar ejecutables";
                    description: "Elige uno o varios .exe a la vez: cada uno será un juego independiente, aunque estén en la misma carpeta. Verás una vista previa y se evitan los duplicados. Un acceso directo (.lnk) se resuelve a su ejecutable real, con sus argumentos.";
                    button-text: "Elegir ejecutables…";
                    button2-text: "Desde una carpeta de accesos directos…";
                    button-enabled: !root.busy;
                    activated => { root.import-exes-clicked(); }
                    activated2 => { root.import-shortcuts-clicked(); }
                }
                ImportCard {
                    height: 140px;
                    heading: "Importar carpeta de Steam";
                    description: "Selecciona tu carpeta de Steam (o una biblioteca adicional). UGL lee los archivos locales appmanifest y libraryfolders.vdf: no necesita iniciar sesión ni conexión.";
                    button-text: "Elegir carpeta de Steam…";
                    button-enabled: !root.busy;
                    activated => { root.import-steam-clicked(); }
                }
            }

            // ---- Ajustes ----
            if root.current-view == 2 : VerticalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                alignment: start;

                Text {
                    text: "Ajustes";
                    color: #f2e6d4;
                    font-size: 24px;
                    font-weight: 700;
                }
                Text {
                    text: "Versión: " + root.version-text;
                    color: #b9a58e;
                    font-size: 13px;
                }
                Text {
                    text: "Carpeta de datos: " + root.data-dir;
                    color: #b9a58e;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Base de datos: " + root.db-path;
                    color: #b9a58e;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Registro de diagnóstico: " + root.log-path;
                    color: #b9a58e;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: "El orden de la biblioteca y la última carpeta de importación se guardan automáticamente.";
                    color: #8a7662;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle { height: 8px; }
                CheckBox {
                    text: "Actualizar automáticamente juegos de Steam y logros";
                    checked <=> root.auto-update;
                    toggled => { root.auto-update-toggled(self.checked); }
                }
                Text {
                    text: "Vigila tu carpeta de Steam con eventos del sistema (sin sondeo): detecta juegos nuevos al terminar de instalarse y actualiza los logros en cuanto Steam los guarda.";
                    color: #8a7662;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                CheckBox {
                    text: "Descargar de Steam las imágenes de logros que falten";
                    checked <=> root.download-icons;
                    toggled => { root.download-icons-toggled(self.checked); }
                }
                Text {
                    text: "Usa internet: pide a los servidores de imágenes de Steam solo el icono de cada logro (por AppID y código de imagen) y lo guarda en tu equipo. Desactívala y UGL funcionará sin conexión con las imágenes que ya existan.";
                    color: #8a7662;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                CheckBox {
                    text: "Descargar la ficha pública de Steam Store (nombre, descripción y portada)";
                    checked <=> root.fetch-metadata;
                    toggled => { root.fetch-metadata-toggled(self.checked); }
                }
                Text {
                    text: "Usa internet y no necesita Steam instalado ni tu cuenta: consulta la tienda pública solo con el AppID de cada juego y guarda el resultado en tu equipo para funcionar sin conexión.";
                    color: #8a7662;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                CheckBox {
                    text: "Minimizar UGL a la bandeja al iniciar un juego";
                    checked <=> root.minimize-on-launch;
                    toggled => { root.minimize-on-launch-toggled(self.checked); }
                }
                Text {
                    text: "UGL se oculta en la bandeja del sistema mientras juegas y vuelve a mostrarse al cerrar el juego. Puedes abrirlo o salir desde su icono de la bandeja.";
                    color: #8a7662;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            // ---- Cuenta de itch.io ----
            if root.current-view == 3 : VerticalLayout {
                vertical-stretch: 1;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Cuenta de itch.io";
                    color: #f2e6d4;
                    font-size: 24px;
                    font-weight: 700;
                }
                Text {
                    text: "Es opcional: UGL funciona igual sin ella. Al vincularla, los juegos de tu biblioteca de itch.io (comprados o reclamados) aparecen en UGL aunque no estén instalados en este equipo.";
                    color: #b9a58e;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.account-status;
                    color: #e8b96a;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.account-key-input;
                        input-type: InputType.password;
                        placeholder-text: "Pega aquí tu clave de API de itch.io";
                        accepted => { root.account-save-key(root.account-key-input); }
                    }
                    Button {
                        text: "Vincular con esta clave";
                        primary: true;
                        enabled: !root.account-busy;
                        clicked => { root.account-save-key(root.account-key-input); }
                    }
                    Button {
                        text: "Conseguir clave";
                        clicked => { root.account-open-key-page(); }
                    }
                }
                Text {
                    text: "Así se vincula una cuenta de itch.io desde una aplicación: con una clave de API personal, que generas tú en itch.io (Ajustes → API keys → «Generate new API key»; el botón «Conseguir clave» abre esa página). UGL nunca ve tu usuario ni tu contraseña. La clave se guarda cifrada con tu usuario de Windows y solo se usa para leer tu biblioteca; al desvincular se borra.";
                    color: #8a7662;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 10px;
                    Button {
                        text: "Sincronizar biblioteca";
                        primary: true;
                        enabled: root.account-linked && !root.account-busy;
                        clicked => { root.account-sync-clicked(); }
                    }
                    if root.account-linked : Button {
                        text: "Desvincular cuenta";
                        enabled: !root.account-busy;
                        clicked => { root.account-unlink-clicked(); }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.account-sync-status;
                        color: #b9a58e;
                        font-size: 12px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
                CheckBox {
                    text: "Mostrar en la biblioteca los juegos de mi cuenta que no están instalados";
                    checked <=> root.show-owned;
                    toggled => { root.show-owned-toggled(self.checked); }
                }
            }

            // ---- Barra de estado ----
            Text {
                text: root.status-text;
                color: #b9a58e;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }

    // ---- Diálogo: importar juego individual ----
    if root.import-dialog-visible : Rectangle {
        background: #000000c0;

        TouchArea { }

        Rectangle {
            width: Math.min(680px, parent.width - 48px);
            height: Math.min(580px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #2a1f18;
            border-radius: 12px;
            border-width: 1px;
            border-color: #4a3626;

            VerticalLayout {
                padding: 20px;
                spacing: 10px;

                Text {
                    text: "Importar juego";
                    color: #f2e6d4;
                    font-size: 20px;
                    font-weight: 700;
                }
                Text {
                    text: root.import-folder;
                    color: #8a7662;
                    font-size: 12px;
                    overflow: elide;
                }
                Text {
                    text: "Nombre del juego";
                    color: #b9a58e;
                    font-size: 12px;
                }
                LineEdit {
                    text <=> root.import-name;
                    placeholder-text: "Nombre del juego";
                }
                Text {
                    text: root.exe-candidates.length == 0 ? "No se encontraron ejecutables en esta carpeta. Puedes buscar uno manualmente." : "Ejecutable para iniciar el juego";
                    color: #b9a58e;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                ListView {
                    vertical-stretch: 1;
                    for exe[i] in root.exe-candidates : Rectangle {
                        height: 46px;
                        border-radius: 6px;
                        background: root.selected-exe == i ? #4a3626 : (exe-area.has-hover ? #36281d : transparent);

                        exe-area := TouchArea {
                            clicked => { root.selected-exe = i; }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: exe.label;
                                    color: #f2e6d4;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                                Text {
                                    text: exe.detail;
                                    color: #8a7662;
                                    font-size: 11px;
                                }
                            }
                            Text {
                                text: exe.suggested ? "Sugerido" : "";
                                color: #c98a3b;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: root.scan-note;
                    visible: root.scan-note != "";
                    color: #c98a3b;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Buscar otro ejecutable…";
                        clicked => { root.browse-exe-clicked(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Cancelar";
                        clicked => { root.import-cancel(); }
                    }
                    Button {
                        text: "Añadir a la biblioteca";
                        primary: true;
                        enabled: root.selected-exe >= 0 && root.import-name != "";
                        clicked => { root.import-confirm(root.import-name, root.selected-exe); }
                    }
                }
            }
        }
    }

    // ---- Vista previa de importación de ejecutables ----
    if root.preview-visible : Rectangle {
        background: #000000c0;

        TouchArea { }

        Rectangle {
            width: Math.min(860px, parent.width - 48px);
            height: Math.min(640px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #2a1f18;
            border-radius: 12px;
            border-width: 1px;
            border-color: #4a3626;

            VerticalLayout {
                padding: 20px;
                spacing: 10px;

                Text {
                    text: "Vista previa de la importación";
                    color: #f2e6d4;
                    font-size: 20px;
                    font-weight: 700;
                }
                Text {
                    text: root.preview-summary;
                    color: #b9a58e;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                ListView {
                    vertical-stretch: 1;
                    for item[i] in root.preview-items : Rectangle {
                        height: 78px;
                        border-radius: 6px;
                        background: item.status-kind == 0 ? #2f2218 : #221813;

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 12px;

                            CheckBox {
                                enabled: item.selectable;
                                checked: item.include;
                                toggled => { root.preview-toggled(i, self.checked); }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 3px;

                                LineEdit {
                                    text: item.name;
                                    enabled: item.selectable;
                                    edited(value) => { root.preview-name-edited(i, value); }
                                }
                                Text {
                                    text: item.path;
                                    color: #8a7662;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                                Text {
                                    text: item.note;
                                    color: item.status-kind == 2 ? #d9825b : #b9a58e;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                            Text {
                                width: 96px;
                                text: item.status;
                                color: item.status-kind == 0 ? #7fc15b : (item.status-kind == 1 ? #c98a3b : #d9825b);
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Cancelar";
                        clicked => { root.preview-cancel(); }
                    }
                    Button {
                        text: "Importar " + root.preview-selected + " juego(s)";
                        primary: true;
                        enabled: root.preview-selected > 0;
                        clicked => { root.preview-confirm(); }
                    }
                }
            }
        }
    }

    // ---- Ficha del juego ----
    if root.detail-visible : Rectangle {
        background: #000000c0;

        TouchArea { }

        Rectangle {
            width: Math.min(680px, parent.width - 48px);
            height: Math.min(600px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #2a1f18;
            border-radius: 12px;
            border-width: 1px;
            border-color: #4a3626;

            VerticalLayout {
                padding: 22px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 14px;

                    GameIcon {
                        side: 56px;
                        icon: root.detail.icon;
                        has-icon: root.detail.has-icon;
                        initial: root.detail.initial;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.detail.title;
                        color: #f2e6d4;
                        font-size: 22px;
                        font-weight: 700;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
                if root.detail.has-cover || root.detail.info != "" || root.detail.description != "" : HorizontalLayout {
                    spacing: 14px;

                    if root.detail.has-cover : Rectangle {
                        width: 96px;
                        height: 144px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #4a3626;
                        clip: true;

                        Image {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            source: root.detail.cover;
                            image-fit: cover;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        alignment: start;

                        if root.detail.info != "" : Text {
                            text: root.detail.info;
                            color: #e8b96a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if root.detail.description != "" : Text {
                            text: root.detail.description;
                            color: #b9a58e;
                            font-size: 12px;
                            wrap: word-wrap;
                            overflow: elide;
                            max-height: 100px;
                        }
                        if root.detail.can-use-store-name : Button {
                            text: "Usar el nombre de Steam: " + root.detail.store-name;
                            clicked => { root.use-store-name-clicked(root.detail.id); }
                        }
                    }
                }
                Text {
                    text: "Origen: " + root.detail.source;
                    color: #b9a58e;
                    font-size: 13px;
                }
                Text {
                    text: "Carpeta: " + root.detail.install-path;
                    color: #b9a58e;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Inicio: " + root.detail.launch-target;
                    color: #b9a58e;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Estado: " + root.detail.status;
                    color: #c98a3b;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                if root.confirm-remove : Text {
                    text: "Se quitará solo de la biblioteca de UGL. No se borra ningún archivo del juego.";
                    color: #c98a3b;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Jugar";
                        primary: true;
                        clicked => { root.play-clicked(root.detail.id); }
                    }
                    if root.detail.can-show-achievements : Button {
                        text: root.detail.ach-total > 0 ? "Logros (" + root.detail.ach-unlocked + "/" + root.detail.ach-total + ")" : "Logros";
                        clicked => { root.achievements-clicked(root.detail.id); }
                    }
                    Button {
                        text: "Cambiar ejecutable…";
                        enabled: root.detail.can-change-exe;
                        clicked => { root.change-exe-clicked(root.detail.id); }
                    }
                    Button {
                        text: "Cambiar carpeta…";
                        enabled: root.detail.can-change-path;
                        clicked => { root.change-path-clicked(root.detail.id); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    if !root.confirm-remove : Button {
                        text: "Quitar de la biblioteca";
                        clicked => { root.confirm-remove = true; }
                    }
                    if !root.confirm-remove : Button {
                        text: "Método de inicio…";
                        clicked => { root.launch-settings-clicked(root.detail.id); }
                    }
                    if !root.confirm-remove : Button {
                        text: "Asociar con Steam…";
                        clicked => { root.steam-link-clicked(root.detail.id); }
                    }
                    if root.confirm-remove : Button {
                        text: "Sí, quitar";
                        clicked => { root.remove-clicked(root.detail.id); }
                    }
                    if root.confirm-remove : Button {
                        text: "Cancelar";
                        clicked => { root.confirm-remove = false; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Cerrar";
                        clicked => { root.detail-close(); }
                    }
                }
            }
        }
    }

    // ---- Método de inicio de un juego ----
    if root.launch-dialog-visible : Rectangle {
        background: #000000c0;

        TouchArea { }

        Rectangle {
            width: Math.min(680px, parent.width - 48px);
            height: Math.min(520px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #2a1f18;
            border-radius: 12px;
            border-width: 1px;
            border-color: #4a3626;

            VerticalLayout {
                padding: 22px;
                spacing: 8px;

                Text {
                    text: "Método de inicio";
                    color: #f2e6d4;
                    font-size: 20px;
                    font-weight: 700;
                }
                Text {
                    text: root.launch-game-title;
                    color: #8a7662;
                    font-size: 12px;
                    overflow: elide;
                }
                ComboBox {
                    model: ["Ejecutable directo (.exe)", "Steam", "Otra plataforma (dirección)"];
                    current-index <=> root.launch-method;
                }

                if root.launch-method == 0 : VerticalLayout {
                    spacing: 6px;

                    Text { text: "Ejecutable"; color: #b9a58e; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.launch-exe;
                            placeholder-text: "Ruta del .exe";
                        }
                        Button {
                            text: "Elegir…";
                            clicked => { root.launch-browse-exe(); }
                        }
                    }
                    Text { text: "Argumentos"; color: #b9a58e; font-size: 12px; }
                    LineEdit {
                        text <=> root.launch-args;
                        placeholder-text: "-windowed -nolauncher";
                    }
                    Text { text: "Directorio de trabajo (vacío = carpeta del ejecutable)"; color: #b9a58e; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.launch-workdir;
                            placeholder-text: "Opcional";
                        }
                        Button {
                            text: "Elegir…";
                            clicked => { root.launch-browse-workdir(); }
                        }
                    }
                }
                if root.launch-method == 1 : VerticalLayout {
                    spacing: 6px;

                    Text { text: "AppID de Steam"; color: #b9a58e; font-size: 12px; }
                    LineEdit {
                        text <=> root.launch-steam-id;
                        placeholder-text: "Por ejemplo, 220";
                    }
                    Text {
                        text: "El juego se inicia con steam://rungameid/<AppID> y Steam se encarga del resto. El ejecutable que ya se conoce se conserva por si quieres volver al inicio directo.";
                        color: #8a7662;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
                if root.launch-method == 2 : VerticalLayout {
                    spacing: 6px;

                    Text { text: "Dirección de la plataforma"; color: #b9a58e; font-size: 12px; }
                    LineEdit {
                        text <=> root.launch-uri;
                        placeholder-text: "goggalaxy://openGameView/123";
                    }
                    Text {
                        text: "Esquemas admitidos: steam, com.epicgames.launcher, goggalaxy, itch, uplay, origin2 y battlenet.";
                        color: #8a7662;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }

                Rectangle { vertical-stretch: 1; }
                Text {
                    text: root.launch-error;
                    visible: root.launch-error != "";
                    color: #d9825b;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Cancelar";
                        clicked => { root.launch-cancel(); }
                    }
                    Button {
                        text: "Guardar";
                        primary: true;
                        clicked => { root.launch-save(root.launch-game-id); }
                    }
                }
            }
        }
    }

    // ---- Asociar con una ficha de Steam ----
    if root.link-dialog-visible : Rectangle {
        background: #000000c0;

        TouchArea { }

        Rectangle {
            width: Math.min(640px, parent.width - 48px);
            height: Math.min(520px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #2a1f18;
            border-radius: 12px;
            border-width: 1px;
            border-color: #4a3626;

            VerticalLayout {
                padding: 22px;
                spacing: 8px;

                Text {
                    text: "Asociar con una ficha de Steam";
                    color: #f2e6d4;
                    font-size: 20px;
                    font-weight: 700;
                }
                Text {
                    text: root.link-game-title;
                    color: #8a7662;
                    font-size: 12px;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.link-query;
                        placeholder-text: "Nombre del juego o AppID";
                        accepted => { root.steam-link-search(root.link-query); }
                    }
                    Button {
                        text: "Buscar";
                        enabled: !root.link-busy;
                        clicked => { root.steam-link-search(root.link-query); }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for result[i] in root.link-results : Rectangle {
                        height: 44px;
                        border-radius: 6px;
                        background: root.link-selected == i ? #4a3626 : (result-area.has-hover ? #36281d : transparent);

                        result-area := TouchArea {
                            clicked => { root.link-selected = i; }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;

                            Text {
                                horizontal-stretch: 1;
                                text: result.name;
                                color: #f2e6d4;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: "AppID " + result.app-id;
                                color: #8a7662;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: root.link-status;
                    color: #c98a3b;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Cancelar";
                        clicked => { root.steam-link-cancel(); }
                    }
                    Button {
                        text: "Asociar";
                        primary: true;
                        enabled: root.link-selected >= 0 && !root.link-busy;
                        clicked => { root.steam-link-confirm(root.link-game-id); }
                    }
                }
            }
        }
    }

    // ---- Juego de la cuenta que no está instalado ----
    if root.owned-dialog-visible : Rectangle {
        background: #000000c0;

        TouchArea { }

        Rectangle {
            width: Math.min(560px, parent.width - 48px);
            height: Math.min(380px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #2a1f18;
            border-radius: 12px;
            border-width: 1px;
            border-color: #4a3626;

            VerticalLayout {
                padding: 22px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 16px;

                    if root.owned-has-cover : Rectangle {
                        width: 110px;
                        height: 165px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #4a3626;
                        clip: true;

                        Image {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            source: root.owned-cover;
                            image-fit: cover;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: root.owned-title;
                            color: #f2e6d4;
                            font-size: 22px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Está en tu biblioteca de itch.io, pero no instalado en este equipo.";
                            color: #c98a3b;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.owned-info;
                            color: #e8b96a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.owned-description;
                            color: #b9a58e;
                            font-size: 12px;
                            wrap: word-wrap;
                            overflow: elide;
                            max-height: 110px;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Abrir en itch.io";
                        primary: true;
                        clicked => { root.owned-store(root.owned-app-id); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Cerrar";
                        clicked => { root.owned-close(); }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Ventana de logros: estructura de la «blade» de Xbox 360 con la paleta de UGL
// ---------------------------------------------------------------------------

component FilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    width: 124px;
    height: 32px;
    border-radius: 16px;
    border-width: 1px;
    border-color: #4a3626;
    background: root.selected ? #c98a3b : #2a1f18;

    TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.selected ? #1c1511 : #b9a58e;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component AchievementRow inherits Rectangle {
    in property <AchievementItem> item;
    height: 92px;

    Rectangle {
        x: 0px;
        y: 3px;
        width: parent.width;
        height: parent.height - 6px;
        border-radius: 6px;
        background: root.item.unlocked ? #2f2218 : #221813;
        clip: true;

        // Barra lateral: ámbar cuando está desbloqueado
        Rectangle {
            x: 0px;
            y: 0px;
            width: 5px;
            height: parent.height;
            background: root.item.unlocked ? #c98a3b : #3b2b1f;
        }

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 14px;
            padding-top: 9px;
            padding-bottom: 9px;
            spacing: 14px;

            // Icono (o estrella si no hay imagen en la caché local)
            Rectangle {
                width: 64px;
                height: 64px;
                border-radius: 4px;
                border-width: 1px;
                border-color: #4a3626;
                background: #140e0a;
                clip: true;

                if root.item.has-icon : Image {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    source: root.item.icon;
                    image-fit: contain;
                    opacity: root.item.unlocked ? 1.0 : 0.5;
                }
                if !root.item.has-icon : Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 30px;
                    height: 30px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: "M 12 2 L 15 9 L 22 9 L 16.5 13.5 L 18.5 21 L 12 16.5 L 5.5 21 L 7.5 13.5 L 2 9 L 9 9 Z";
                    fill: root.item.unlocked ? #c98a3b : #4a3626;
                }
            }

            // Nombre y descripción
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;

                Text {
                    text: root.item.name;
                    color: root.item.unlocked ? #f2e6d4 : #b9a58e;
                    font-size: 16px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.item.description;
                    color: #8a7662;
                    font-size: 12px;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 34px;
                }
            }

            // Estado: marca de verificación, fecha y procedencia
            VerticalLayout {
                width: 150px;
                alignment: center;
                spacing: 4px;

                if root.item.unlocked : HorizontalLayout {
                    alignment: end;
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M 3 13 L 9 19 L 21 5";
                        stroke: #7fc15b;
                        stroke-width: 3px;
                    }
                }
                Text {
                    text: root.item.date-text;
                    color: root.item.unlocked ? #e8b96a : #6f5d4b;
                    font-size: 11px;
                    horizontal-alignment: right;
                    wrap: word-wrap;
                }
                Text {
                    text: root.item.provenance;
                    color: #8a7662;
                    font-size: 10px;
                    horizontal-alignment: right;
                }
            }
        }
    }
}

export component AchievementsWindow inherits Window {
    title: "UGL — Logros";
    icon: @image-url("../assets/ugl.png");
    preferred-width: 780px;
    preferred-height: 660px;
    min-width: 640px;
    min-height: 480px;
    background: #1c1511;

    in property <int> game-id;
    in property <string> game-title;
    in property <string> summary-text;
    in property <string> percent-text;
    in property <float> progress: 0.0;
    in property <[AchievementItem]> items;
    in property <string> status-text;
    in property <bool> busy: false;
    in-out property <int> filter: 0;

    callback filter-changed(int);
    callback refresh-clicked(int);
    callback close-clicked();

    VerticalLayout {
        // Cabecera
        Rectangle {
            height: 124px;
            background: #140e0a;

            Rectangle {
                x: 0px;
                y: parent.height - 3px;
                width: parent.width;
                height: 3px;
                background: #c98a3b;
            }

            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 18px;
                padding-bottom: 18px;
                spacing: 6px;

                Text {
                    text: "LOGROS";
                    color: #c98a3b;
                    font-size: 12px;
                    font-weight: 800;
                }
                Text {
                    text: root.game-title;
                    color: #f2e6d4;
                    font-size: 26px;
                    font-weight: 700;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 14px;

                    Text {
                        text: root.summary-text;
                        color: #b9a58e;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;

                        Rectangle {
                            height: 10px;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: #4a3626;
                            background: #2a1f18;
                            clip: true;

                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: parent.width * root.progress;
                                height: parent.height;
                                background: #c98a3b;
                            }
                        }
                    }
                    Text {
                        text: root.percent-text;
                        color: #e8b96a;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Filtros y acciones
        HorizontalLayout {
            padding: 16px;
            spacing: 10px;

            FilterChip {
                label: "Todos";
                selected: root.filter == 0;
                clicked => { root.filter-changed(0); }
            }
            FilterChip {
                label: "Desbloqueados";
                selected: root.filter == 1;
                clicked => { root.filter-changed(1); }
            }
            FilterChip {
                label: "Bloqueados";
                selected: root.filter == 2;
                clicked => { root.filter-changed(2); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Actualizar";
                enabled: !root.busy;
                clicked => { root.refresh-clicked(root.game-id); }
            }
            Button {
                text: "Cerrar";
                clicked => { root.close-clicked(); }
            }
        }

        // Lista
        VerticalLayout {
            vertical-stretch: 1;
            padding-left: 16px;
            padding-right: 16px;

            if root.items.length == 0 : Rectangle {
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "No hay logros para mostrar.";
                    color: #8a7662;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.items.length > 0 : ListView {
                for item in root.items : AchievementRow {
                    item: item;
                }
            }
        }

        // Pie: estado y aviso de procedencia
        Rectangle {
            height: 62px;
            background: #140e0a;

            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 2px;

                Text {
                    text: root.status-text;
                    color: #c98a3b;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Logros importados de la caché local de Steam. UGL no puede verificarlos oficialmente.";
                    color: #8a7662;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
